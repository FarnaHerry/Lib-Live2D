+#ifdef CSM_TARGET_LINUX_GL
+// LLMSWITCH_CUBISM_LINUX_GLES3_VBO_PATCH: stream model and quad data through buffers.
+void CubismRenderer_OpenGLES2::UploadVertexBuffer(const csmFloat32* vertexArray, const csmFloat32* uvArray, csmUint32 vertexCount)
+{
+    if (_vertexBuffer == 0)
+    {
+        glGenBuffers(1, &_vertexBuffer);
+    }
+
+    _interleavedVertexData.resize(static_cast<std::size_t>(vertexCount) * 4);
+    for (csmUint32 vertex = 0; vertex < vertexCount; ++vertex)
+    {
+        const std::size_t sourceOffset = static_cast<std::size_t>(vertex) * 2;
+        const std::size_t targetOffset = static_cast<std::size_t>(vertex) * 4;
+        _interleavedVertexData[targetOffset] = vertexArray[sourceOffset];
+        _interleavedVertexData[targetOffset + 1] = vertexArray[sourceOffset + 1];
+        _interleavedVertexData[targetOffset + 2] = uvArray[sourceOffset];
+        _interleavedVertexData[targetOffset + 3] = uvArray[sourceOffset + 1];
+    }
+
+    glBindBuffer(GL_ARRAY_BUFFER, _vertexBuffer);
+    glBufferData(GL_ARRAY_BUFFER,
+                 static_cast<GLsizeiptr>(_interleavedVertexData.size() * sizeof(csmFloat32)),
+                 _interleavedVertexData.data(), GL_STREAM_DRAW);
+}
+
+void CubismRenderer_OpenGLES2::UploadIndexBuffer(const csmUint16* indexArray, csmUint32 indexCount)
+{
+    if (_indexBuffer == 0)
+    {
+        glGenBuffers(1, &_indexBuffer);
+    }
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, _indexBuffer);
+    glBufferData(GL_ELEMENT_ARRAY_BUFFER,
+                 static_cast<GLsizeiptr>(static_cast<std::size_t>(indexCount) * sizeof(csmUint16)),
+                 indexArray, GL_STREAM_DRAW);
+}
+#endif
